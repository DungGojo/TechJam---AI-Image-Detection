  <diagram name="5. Hardware and Frameworks" id="page-runtime">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1000" background="#ffffff" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="Runtime — Hardware Requirements and Framework Stack" style="text;html=1;fontSize=20;fontStyle=1;align=left;verticalAlign=middle;fontColor=#1a1a2e;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="1400" height="30" as="geometry" /></mxCell>
        <mxCell id="subtitle" value="what each stage needs to run on, and which library owns which part of the pipeline" style="text;html=1;fontSize=12;align=left;verticalAlign=middle;fontColor=#555555;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="40" y="42" width="1500" height="20" as="geometry" /></mxCell>
        <mxCell id="g_hw" value="Hardware requirements by stage" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f7f2fa;strokeColor=#9673a6;dashed=1;verticalAlign=top;align=left;fontSize=13;fontStyle=1;fontColor=#5f3a75;spacingLeft=10;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="30" y="90" width="800" height="520" as="geometry" /></mxCell>
        <mxCell id="hw_train" value="Train DINOv3-L  (notebook 01)
CUDA GPU strongly recommended
300M-param backbone + AMP activations
drive memory; CPU is impractical" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="60" y="140" width="350" height="100" as="geometry" /></mxCell>
        <mxCell id="hw_stack" value="Train stacking head  (notebook 02)
Phase 1 cache_features: GPU — frozen ViT-B
+ CF expert over every image × 3 crops × 3
variants. Phase 2 head.fit: CPU-feasible" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="440" y="140" width="360" height="100" as="geometry" /></mxCell>
        <mxCell id="hw_meta" value="Score meta-dataset  (notebook 03)
GPU: all three detectors over 2,000 images" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="60" y="265" width="350" height="70" as="geometry" /></mxCell>
        <mxCell id="hw_fuse" value="Fit fusion  (notebook 04)
CPU only. 2,000 × 3 table — seconds" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#38761d;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="440" y="265" width="360" height="70" as="geometry" /></mxCell>
        <mxCell id="hw_inf" value="Inference  (classify.py / notebook 06 / Kaggle)
CUDA → MPS → CPU, auto-selected.
Peak VRAM = ONE detector, not three:
each is built, used, then released." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="60" y="360" width="350" height="105" as="geometry" /></mxCell>
        <mxCell id="hw_thr" value="Measured throughput
Tesla T4    0.48 s / image
Apple MPS   ~1.3 s / image
CPU         works, slower" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="440" y="360" width="360" height="105" as="geometry" /></mxCell>
        <mxCell id="hw_disk" value="Disk at rest — 1.2 GB DINOv3-L · 9.8 MB stacking head · 8 KB fusion artifact · ~1.5 GB Hugging Face backbone cache after first run.
Benchmark adds ~2.9 GB of images. Kaggle's 20 GB working volume is ample; a full run peaked well under it." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontSize=11;" vertex="1" parent="1"><mxGeometry x="60" y="490" width="740" height="60" as="geometry" /></mxCell>
        <mxCell id="g_gpu" value="GPU compatibility — a real constraint, not a footnote" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f7f2fa;strokeColor=#9673a6;dashed=1;verticalAlign=top;align=left;fontSize=13;fontStyle=1;fontColor=#5f3a75;spacingLeft=10;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="860" y="90" width="800" height="200" as="geometry" /></mxCell>
        <mxCell id="gpu_ok" value="Tesla T4  (sm_75)   WORKS
Also: any GPU of compute capability 7.0+
(V100, A100, L4, RTX 20-series onward)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#38761d;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="890" y="140" width="370" height="100" as="geometry" /></mxCell>
        <mxCell id="gpu_bad" value="Tesla P100  (sm_60)   FAILS
CUDA error: no kernel image available.
Current PyTorch builds ship no kernels
below sm_70 — every forward pass dies." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1290" y="140" width="340" height="100" as="geometry" /></mxCell>
        <mxCell id="g_fw" value="Framework stack — who owns what" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eef4fc;strokeColor=#6c8ebf;dashed=1;verticalAlign=top;align=left;fontSize=13;fontStyle=1;fontColor=#2f4f7f;spacingLeft=10;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="860" y="320" width="800" height="500" as="geometry" /></mxCell>
        <mxCell id="fw_torch" value="PyTorch 2.13 + torchvision 0.28
tensors, autograd, AMP, device placement" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="890" y="370" width="740" height="55" as="geometry" /></mxCell>
        <mxCell id="fw_timm" value="timm 1.0.29
both DINOv3 backbones (ViT-L/16, ViT-B/16)
requires &gt;= 1.0.9 — earlier releases have no DINOv3 defs" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="890" y="440" width="740" height="65" as="geometry" /></mxCell>
        <mxCell id="fw_tf" value="transformers 5.16 + huggingface_hub 1.29
Community Forensics ViT and its image processor; model download and cache" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="890" y="520" width="740" height="60" as="geometry" /></mxCell>
        <mxCell id="fw_sk" value="scikit-learn 1.9  ·  joblib 1.5  ·  xgboost 3.2
fusion model, StandardScaler, cross-validation, every reported metric; joblib persists the artifact" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1"><mxGeometry x="890" y="595" width="740" height="65" as="geometry" /></mxCell>
        <mxCell id="fw_data" value="NumPy 2.4  ·  pandas 3.0  ·  Pillow 12.3  ·  SciPy 1.17
arrays, manifests, image decode, score caches" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="890" y="675" width="740" height="55" as="geometry" /></mxCell>
        <mxCell id="fw_net" value="requests 2.34  ·  modelscope 1.39  ·  tqdm 4.70
ZIP range-request downloads, ModelScope file listing, progress reporting" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontSize=11;" vertex="1" parent="1"><mxGeometry x="890" y="745" width="740" height="55" as="geometry" /></mxCell>
        <mxCell id="hw_note" value="Versions are those installed in the project .venv (Python 3.11). requirements.txt pins lower bounds only, so newer releases are expected to work — the one hard floor is timm &gt;= 1.0.9 for the DINOv3 model definitions. Nothing in the codebase hardcodes a device: Modeling/common/device.py is the single source of truth and every script calls get_device()." style="text;html=1;fontSize=10;align=left;verticalAlign=top;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="30" y="860" width="1620" height="55" as="geometry" /></mxCell>
        <mxCell id="r1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#666666;fontSize=10;" edge="1" parent="1" source="hw_train" target="hw_meta"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="r2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#666666;fontSize=10;" edge="1" parent="1" source="hw_stack" target="hw_meta"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="r3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#666666;fontSize=10;" edge="1" parent="1" source="hw_meta" target="hw_fuse"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="r4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#666666;fontSize=10;" edge="1" parent="1" source="hw_fuse" target="hw_inf"><mxGeometry relative="1" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram name="6. Degradation Engine" id="page-degrade">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1780" pageHeight="1080" background="#ffffff" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="Degradation Engine — Modeling/common/degradations.py" style="text;html=1;fontSize=20;fontStyle=1;align=left;verticalAlign=middle;fontColor=#1a1a2e;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="1500" height="30" as="geometry" /></mxCell>
        <mxCell id="subtitle" value="one severity scale drives ten transforms; a curriculum escalates them during training; a separate fixed grid measures robustness" style="text;html=1;fontSize=12;align=left;verticalAlign=middle;fontColor=#555555;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="40" y="42" width="1600" height="20" as="geometry" /></mxCell>
        <mxCell id="g_fam" value="Ten transform families — each maps the shared severity [0, 5] onto its own parameter range" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eef4fc;strokeColor=#6c8ebf;dashed=1;verticalAlign=top;align=left;fontSize=13;fontStyle=1;fontColor=#2f4f7f;spacingLeft=10;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="30" y="90" width="1000" height="330" as="geometry" /></mxCell>
        <mxCell id="f_jpeg" value="jpeg
quality  95 → 25" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1"><mxGeometry x="60" y="140" width="220" height="55" as="geometry" /></mxCell>
        <mxCell id="f_blur" value="blur
sigma  0.0 → 2.5" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1"><mxGeometry x="300" y="140" width="220" height="55" as="geometry" /></mxCell>
        <mxCell id="f_resize" value="resize
scale  1.0 → 0.2  (down then up)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1"><mxGeometry x="540" y="140" width="220" height="55" as="geometry" /></mxCell>
        <mxCell id="f_noise" value="noise
additive sigma  0.0 → 0.12" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1"><mxGeometry x="780" y="140" width="220" height="55" as="geometry" /></mxCell>
        <mxCell id="f_jitter" value="jitter
bright/contrast/sat  0.0 → 0.30" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1"><mxGeometry x="60" y="215" width="220" height="55" as="geometry" /></mxCell>
        <mxCell id="f_crop" value="crop
centre keep  1.0 → 0.65" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1"><mxGeometry x="300" y="215" width="220" height="55" as="geometry" /></mxCell>
        <mxCell id="f_held" value="HELD OUT — never in the reported grid, used to measure generalisation beyond it" style="text;html=1;fontSize=10;align=left;verticalAlign=top;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="60" y="290" width="940" height="25" as="geometry" /></mxCell>
        <mxCell id="f_webp" value="webp
quality  95 → 30" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="60" y="325" width="220" height="50" as="geometry" /></mxCell>
        <mxCell id="f_sharpen" value="sharpen
amount  0.0 → 1.5" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="300" y="325" width="220" height="50" as="geometry" /></mxCell>
        <mxCell id="f_speckle" value="speckle
multiplicative  0.0 → 0.2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="540" y="325" width="220" height="50" as="geometry" /></mxCell>
        <mxCell id="f_cast" value="cast
per-channel gain  0.0 → 0.25" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="780" y="325" width="220" height="50" as="geometry" /></mxCell>
        <mxCell id="sev" value="Severity → parameter
value_at(s) = lerp(lo, hi, s/5)
integral families round to int" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1080" y="140" width="300" height="90" as="geometry" /></mxCell>
        <mxCell id="g_tier" value="Tiers — how many transforms, and how hard" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fffbf0;strokeColor=#d6b656;dashed=1;verticalAlign=top;align=left;fontSize=13;fontStyle=1;fontColor=#7f6000;spacingLeft=10;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="1080" y="260" width="660" height="200" as="geometry" /></mxCell>
        <mxCell id="t_clean" value="clean
0 transforms" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1110" y="305" width="300" height="45" as="geometry" /></mxCell>
        <mxCell id="t_mild" value="mild
1–3 · severity ~ N(0.0, 2.5)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1430" y="305" width="290" height="45" as="geometry" /></mxCell>
        <mxCell id="t_mod" value="moderate
3–6 · severity ~ N(2.5, 2.0)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1110" y="365" width="300" height="45" as="geometry" /></mxCell>
        <mxCell id="t_heavy" value="heavy
6 · severity ~ N(3.5, 1.0)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1430" y="365" width="290" height="45" as="geometry" /></mxCell>
        <mxCell id="g_cur" value="Curriculum — tier probabilities escalate across training (schedule = &quot;escalate&quot;)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eef8f0;strokeColor=#82b366;dashed=1;verticalAlign=top;align=left;fontSize=13;fontStyle=1;fontColor=#2f6b3d;spacingLeft=10;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="30" y="470" width="1000" height="220" as="geometry" /></mxCell>
        <mxCell id="cur0" value="Epoch 0 of 10
clean 0.40 · mild 0.40
moderate 0.15 · heavy 0.05" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1"><mxGeometry x="60" y="520" width="300" height="80" as="geometry" /></mxCell>
        <mxCell id="cur4" value="Epoch 4 of 10
clean 0.27 · mild 0.36
moderate 0.24 · heavy 0.14" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1"><mxGeometry x="390" y="520" width="300" height="80" as="geometry" /></mxCell>
        <mxCell id="cur9" value="Epoch 9 of 10
clean 0.10 · mild 0.30
moderate 0.35 · heavy 0.25" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1"><mxGeometry x="720" y="520" width="280" height="80" as="geometry" /></mxCell>
        <mxCell id="cur_note" value="clean is floored at 0.10 — the model never stops seeing undegraded images, so it cannot drift into only recognising damaged ones." style="text;html=1;fontSize=10;align=left;verticalAlign=top;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="60" y="615" width="940" height="30" as="geometry" /></mxCell>
        <mxCell id="g_chain" value="Per-example sampling  (one training image)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f7f2fa;strokeColor=#9673a6;dashed=1;verticalAlign=top;align=left;fontSize=13;fontStyle=1;fontColor=#5f3a75;spacingLeft=10;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="1080" y="490" width="660" height="320" as="geometry" /></mxCell>
        <mxCell id="ch1" value="pick_tier(rng, weights)
sample the tier for THIS example" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1110" y="540" width="600" height="55" as="geometry" /></mxCell>
        <mxCell id="ch2" value="sample_chain(rng, tier)
choose k families WITHOUT replacement,
k drawn from the tier's range" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1110" y="610" width="600" height="70" as="geometry" /></mxCell>
        <mxCell id="ch3" value="severity ~ N(tier.mean, tier.std), clipped to [0, 5]
then value_at() maps it into each family's range" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1110" y="695" width="600" height="55" as="geometry" /></mxCell>
        <mxCell id="ch4" value="apply_chain() — transforms applied in the sampled order" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#b6d7a8;strokeColor=#38761d;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1110" y="765" width="600" height="35" as="geometry" /></mxCell>
        <mxCell id="g_grid" value="Evaluation axis — discrete_grid(), 14 fixed cells at the brief's exact values" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff6ec;strokeColor=#d79b00;dashed=1;verticalAlign=top;align=left;fontSize=13;fontStyle=1;fontColor=#8a5a00;spacingLeft=10;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="30" y="730" width="1000" height="200" as="geometry" /></mxCell>
        <mxCell id="gr_jpeg" value="jpeg  90 · 70 · 50 · 30" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="1"><mxGeometry x="60" y="780" width="460" height="40" as="geometry" /></mxCell>
        <mxCell id="gr_blur" value="blur  0.5 · 1.0 · 2.0" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="1"><mxGeometry x="540" y="780" width="460" height="40" as="geometry" /></mxCell>
        <mxCell id="gr_resize" value="resize  0.5 · 0.25" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="1"><mxGeometry x="60" y="835" width="460" height="40" as="geometry" /></mxCell>
        <mxCell id="gr_noise" value="noise  0.02 · 0.05 · 0.10" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="1"><mxGeometry x="540" y="835" width="460" height="40" as="geometry" /></mxCell>
        <mxCell id="gr_jit" value="jitter  0.20" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="1"><mxGeometry x="60" y="890" width="460" height="30" as="geometry" /></mxCell>
        <mxCell id="gr_crop" value="crop  0.80" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="1"><mxGeometry x="540" y="890" width="460" height="30" as="geometry" /></mxCell>
        <mxCell id="sep" value="THE TWO PATHS ARE SEPARATE BY DESIGN.
Training samples continuous random severities; evaluation uses only these 14 exact cells. Reusing the training sampler to score robustness would let the model be measured on the very distribution it was tuned against." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1080" y="840" width="660" height="90" as="geometry" /></mxCell>
        <mxCell id="n6" value="Held-out families (webp, sharpen, speckle, cast) are in the training pool but never in discrete_grid(), so the reported robustness number is measured only on the brief's six families — while the model has also seen four transforms it is never scored on. That gap is the generalisation test." style="text;html=1;fontSize=10;align=left;verticalAlign=top;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="30" y="960" width="1710" height="45" as="geometry" /></mxCell>
        <mxCell id="d1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#666666;fontSize=10;" edge="1" parent="1" source="f_jpeg" target="sev"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="d2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#666666;fontSize=10;" edge="1" parent="1" source="t_clean" target="ch1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="d3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#666666;fontSize=10;" edge="1" parent="1" source="ch1" target="ch2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="d4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#666666;fontSize=10;" edge="1" parent="1" source="ch2" target="ch3"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="d5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#666666;fontSize=10;" edge="1" parent="1" source="ch3" target="ch4"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="d6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#666666;fontSize=10;" edge="1" parent="1" source="cur0" target="cur4"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="d7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#666666;fontSize=10;" edge="1" parent="1" source="cur4" target="cur9"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="d8" value="tier weights" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#9673a6;fontSize=10;dashed=1;" edge="1" parent="1" source="cur9" target="ch1"><mxGeometry relative="1" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram name="7. Training Loop (Notebook 01)" id="page-nb01">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1900" pageHeight="1180" background="#ffffff" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="Notebook 01 — DINOv3-L Training Loop, End to End" style="text;html=1;fontSize=20;fontStyle=1;align=left;verticalAlign=middle;fontColor=#1a1a2e;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="1500" height="30" as="geometry" /></mxCell>
        <mxCell id="subtitle" value="paired clean/degraded views → four-term robust loss → per-epoch degradation-grid validation → best_robust.pt" style="text;html=1;fontSize=12;align=left;verticalAlign=middle;fontColor=#555555;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="40" y="42" width="1600" height="20" as="geometry" /></mxCell>
        <mxCell id="g_in" value="Data in" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fffbf0;strokeColor=#d6b656;dashed=1;verticalAlign=top;align=left;fontSize=13;fontStyle=1;fontColor=#7f6000;spacingLeft=10;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="30" y="90" width="460" height="300" as="geometry" /></mxCell>
        <mxCell id="i_man" value="manifests: train · validation · test
(+ benchmark, for the quarantine audit)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="60" y="140" width="400" height="60" as="geometry" /></mxCell>
        <mxCell id="i_val" value="validate(frame, blocklist)
missing files · duplicate sha256 ·
benchmark collisions · class balance" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1"><mxGeometry x="60" y="215" width="400" height="75" as="geometry" /></mxCell>
        <mxCell id="i_ds" value="PairedManifestDataset
DataConfig(pairwise=True, hflip=True,
schedule=&quot;escalate&quot;, seed=1337)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1"><mxGeometry x="60" y="305" width="400" height="70" as="geometry" /></mxCell>
        <mxCell id="g_view" value="One example → two views" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eef8f0;strokeColor=#82b366;dashed=1;verticalAlign=top;align=left;fontSize=13;fontStyle=1;fontColor=#2f6b3d;spacingLeft=10;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="540" y="90" width="620" height="300" as="geometry" /></mxCell>
        <mxCell id="v_crop" value="native random crop @ 224
(+ random horizontal flip)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1"><mxGeometry x="570" y="140" width="560" height="50" as="geometry" /></mxCell>
        <mxCell id="v_clean" value="CLEAN view
the crop, untouched" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="570" y="205" width="265" height="70" as="geometry" /></mxCell>
        <mxCell id="v_deg" value="DEGRADED view
same crop → sampled chain
(page 6)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="865" y="205" width="265" height="70" as="geometry" /></mxCell>
        <mxCell id="v_note" value="Both views come from ONE crop. The degradation is applied after cropping, so the consistency
losses cannot exploit a resolution mismatch between the two branches." style="text;html=1;fontSize=10;align=left;verticalAlign=top;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="570" y="290" width="560" height="45" as="geometry" /></mxCell>
        <mxCell id="g_model" value="Expert forward — both views through the same weights" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eef4fc;strokeColor=#6c8ebf;dashed=1;verticalAlign=top;align=left;fontSize=13;fontStyle=1;fontColor=#2f4f7f;spacingLeft=10;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="1210" y="90" width="660" height="300" as="geometry" /></mxCell>
        <mxCell id="m_bb" value="DINOv3-L backbone (frozen)
attention pooling · lora = False" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1240" y="140" width="600" height="55" as="geometry" /></mxCell>
        <mxCell id="m_fc" value="FeatureCorrection (residual FFN, zero-init)
applied to the degraded features" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1240" y="205" width="600" height="55" as="geometry" /></mxCell>
        <mxCell id="m_head" value="Head: hidden 512 → 1 logit
returns (logits, features) for each view" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1240" y="270" width="600" height="55" as="geometry" /></mxCell>
        <mxCell id="m_note" value="Only the correction module and the head receive gradients — the backbone is frozen." style="text;html=1;fontSize=10;align=left;verticalAlign=top;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="1240" y="335" width="600" height="25" as="geometry" /></mxCell>
        <mxCell id="g_loss" value="RobustLoss — four terms  (Modeling/dinov3/losses.py)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff6ec;strokeColor=#d79b00;dashed=1;verticalAlign=top;align=left;fontSize=13;fontStyle=1;fontColor=#8a5a00;spacingLeft=10;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="30" y="420" width="1130" height="240" as="geometry" /></mxCell>
        <mxCell id="l_cc" value="cls_clean
FocalLoss(gamma 2.0, alpha 0.5)
on the clean logits
weight 1.0 (implicit)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="1"><mxGeometry x="60" y="470" width="260" height="95" as="geometry" /></mxCell>
        <mxCell id="l_cd" value="cls_degraded
same focal loss on the
degraded logits
weight 1.00" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="1"><mxGeometry x="340" y="470" width="260" height="95" as="geometry" /></mxCell>
        <mxCell id="l_kl" value="kl
Bernoulli KL, clean (detached)
→ degraded predictions
weight 0.50" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="1"><mxGeometry x="620" y="470" width="260" height="95" as="geometry" /></mxCell>
        <mxCell id="l_fm" value="feat_mse
L2 between normalised clean
(detached) and corrected features
weight 0.25" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="1"><mxGeometry x="900" y="470" width="230" height="95" as="geometry" /></mxCell>
        <mxCell id="l_sum" value="total = cls_clean + 1.00·cls_degraded + 0.50·kl + 0.25·feat_mse" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#b6d7a8;strokeColor=#38761d;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="60" y="580" width="1070" height="35" as="geometry" /></mxCell>
        <mxCell id="l_note" value="The clean branch is detached in both consistency terms, so the degraded view is pulled toward the clean one and never the reverse — the clean prediction cannot be degraded to make the pair agree." style="text;html=1;fontSize=10;align=left;verticalAlign=top;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="60" y="625" width="1070" height="30" as="geometry" /></mxCell>
        <mxCell id="g_opt" value="Optimisation  (TrainConfig)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f7f2fa;strokeColor=#9673a6;dashed=1;verticalAlign=top;align=left;fontSize=13;fontStyle=1;fontColor=#5f3a75;spacingLeft=10;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="1210" y="420" width="660" height="240" as="geometry" /></mxCell>
        <mxCell id="o_opt" value="AdamW · lr 3e-4 · weight decay 0.02
warmup 0.5 epoch, then cosine · grad clip 1.0" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1240" y="470" width="600" height="55" as="geometry" /></mxCell>
        <mxCell id="o_amp" value="AMP mixed precision · batch 32 · 10 epochs
4 dataloader workers (not persistent — each
worker must observe the new curriculum epoch)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1240" y="535" width="600" height="70" as="geometry" /></mxCell>
        <mxCell id="o_swa" value="SWA from 70% of training · EMA off" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1240" y="615" width="600" height="30" as="geometry" /></mxCell>
        <mxCell id="g_val" value="Per-epoch validation — Evaluation/training_validation.py" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eef8f0;strokeColor=#82b366;dashed=1;verticalAlign=top;align=left;fontSize=13;fontStyle=1;fontColor=#2f6b3d;spacingLeft=10;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="30" y="690" width="1130" height="250" as="geometry" /></mxCell>
        <mxCell id="va_grid" value="Score the validation set on CLEAN plus all 14 discrete grid cells
(max_eval_images = 2000, eval_every = 1 epoch)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1"><mxGeometry x="60" y="740" width="1070" height="55" as="geometry" /></mxCell>
        <mxCell id="va_clean" value="clean_auc" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontSize=11;" vertex="1" parent="1"><mxGeometry x="60" y="810" width="250" height="45" as="geometry" /></mxCell>
        <mxCell id="va_rob" value="robust_auc
mean across grid cells" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#b6d7a8;strokeColor=#38761d;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="330" y="810" width="260" height="45" as="geometry" /></mxCell>
        <mxCell id="va_worst" value="worst_cell_auc" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontSize=11;" vertex="1" parent="1"><mxGeometry x="610" y="810" width="250" height="45" as="geometry" /></mxCell>
        <mxCell id="va_gap" value="gap = clean − robust" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontSize=11;" vertex="1" parent="1"><mxGeometry x="880" y="810" width="250" height="45" as="geometry" /></mxCell>
        <mxCell id="va_note" value="Checkpoint selection maximises robust_auc, not clean_auc. Targets asserted in the notebook: robust AUC ≥ 0.85, generalisation gap ≤ 0.10." style="text;html=1;fontSize=10;align=left;verticalAlign=top;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="60" y="870" width="1070" height="30" as="geometry" /></mxCell>
        <mxCell id="ck_best" value="weights/dinov3/notebook_dinov3/best_robust.pt
compact inference checkpoint — selected on robust AUC" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1210" y="700" width="660" height="60" as="geometry" /></mxCell>
        <mxCell id="ck_last" value="last.pt
full resume checkpoint (optimiser, epoch, history)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1210" y="775" width="660" height="50" as="geometry" /></mxCell>
        <mxCell id="g_nbcheck" value="Notebook 01's own end-of-run check — NOT the final fusion" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eef4fc;strokeColor=#6c8ebf;dashed=1;verticalAlign=top;align=left;fontSize=13;fontStyle=1;fontColor=#2f4f7f;spacingLeft=10;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="1210" y="850" width="660" height="240" as="geometry" /></mxCell>
        <mxCell id="nb_a" value="Branch A — this detector" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1240" y="900" width="290" height="40" as="geometry" /></mxCell>
        <mxCell id="nb_b" value="Branch B — Community Forensics" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1550" y="900" width="290" height="40" as="geometry" /></mxCell>
        <mxCell id="nb_fuse" value="Fixed weighted mean  0.70 A + 0.30 B
weights frozen before test to avoid leakage" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1240" y="955" width="600" height="55" as="geometry" /></mxCell>
        <mxCell id="nb_cal" value="TemperatureCalibrator — fitted on validation,
saved to weights/fusion/&lt;run&gt;_temperature.json" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1240" y="1020" width="600" height="55" as="geometry" /></mxCell>
        <mxCell id="warn" value="This 0.70 / 0.30 weighted mean is notebook 01's INTERNAL sanity check on its own branch. It is NOT the shipped fusion.
The production fusion is the linear SVM selected in notebook 04 (page 3), which consumes three probabilities and applies a 0.70 THRESHOLD — a different number that happens to look alike." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="30" y="960" width="1130" height="60" as="geometry" /></mxCell>
        <mxCell id="n7" value="Full-run configuration: 10 epochs, batch 32, input 224, crop_mode random_crop, seed 1337. TEST_MODE swaps in a vit_tiny backbone at 64px for a fast end-to-end smoke run." style="text;html=1;fontSize=10;align=left;verticalAlign=top;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="30" y="1040" width="1130" height="40" as="geometry" /></mxCell>
