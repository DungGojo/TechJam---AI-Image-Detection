        <mxCell id="c2_prob" value="Probability 2
DINOv3-L detector Pr" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#b6d7a8;strokeColor=#38761d;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1280" y="300" width="170" height="90" as="geometry" /></mxCell>
        <mxCell id="c3_box" value="Branch 3 — DINOv3-B Stacking Detector  (frozen backbone + trained head)   [PyTorch · timm]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eef4fc;strokeColor=#6c8ebf;dashed=1;verticalAlign=top;align=left;fontSize=13;fontStyle=1;fontColor=#2f4f7f;spacingLeft=10;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="250" y="500" width="1000" height="240" as="geometry" /></mxCell>
