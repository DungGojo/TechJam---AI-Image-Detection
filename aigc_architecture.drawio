        <mxCell id="c1_box" value="Branch 1 — Community Forensics  (pretrained, off the shelf, no crop TTA)   [transformers]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eef4fc;strokeColor=#6c8ebf;dashed=1;verticalAlign=top;align=left;fontSize=13;fontStyle=1;fontColor=#2f4f7f;spacingLeft=10;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="250" y="90" width="1000" height="130" as="geometry" /></mxCell>
