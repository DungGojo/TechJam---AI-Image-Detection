<mxfile host="app.diagrams.net" version="24.7.17">
  <diagram name="1. Data and Splits" id="page-data">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="900" background="#ffffff" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="Data Pipeline — Raw Archives to Validated Splits" style="text;html=1;fontSize=20;fontStyle=1;align=left;verticalAlign=middle;fontColor=#1a1a2e;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="1400" height="30" as="geometry" /></mxCell>
        <mxCell id="subtitle" value="remote archives → range-request download → manifest with hashes → five splits, leakage-checked" style="text;html=1;fontSize=12;align=left;verticalAlign=middle;fontColor=#555555;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="40" y="42" width="1500" height="20" as="geometry" /></mxCell>
        <mxCell id="g_src" value="Sources  (Data_Pipeline/sources/)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eef4fc;strokeColor=#6c8ebf;dashed=1;verticalAlign=top;align=left;fontSize=13;fontStyle=1;fontColor=#2f4f7f;spacingLeft=10;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="30" y="90" width="400" height="320" as="geometry" /></mxCell>
        <mxCell id="wildfake" value="WildFake  (ModelScope)
hy2628982280/WildFake
28 GB of ZIP archives" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="60" y="135" width="340" height="75" as="geometry" /></mxCell>
        <mxCell id="sidset" value="SID_Set  (Hugging Face)
saberzl/SID_Set
140 GB, streamed" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="60" y="225" width="340" height="75" as="geometry" /></mxCell>
        <mxCell id="coco" value="COCO val2017  (official)
native resolution, 5,000 images" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="60" y="315" width="340" height="65" as="geometry" /></mxCell>
        <mxCell id="remotezip" value="remote_zip.py   [requests]
HTTP range requests over the ZIP
central directory — fetch only the
members needed, never the archive" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1"><mxGeometry x="490" y="150" width="300" height="110" as="geometry" /></mxCell>
        <mxCell id="quarantine" value="Eval-only quarantine
QUARANTINED_PREFIXES
coco/coco2017/val2017/
DALLE/Advanced/DALLE3/" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="490" y="290" width="300" height="100" as="geometry" /></mxCell>
        <mxCell id="g_man" value="Manifest construction  (Data_Pipeline/manifest.py)  [pandas · Pillow]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eef8f0;strokeColor=#82b366;dashed=1;verticalAlign=top;align=left;fontSize=13;fontStyle=1;fontColor=#2f6b3d;spacingLeft=10;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="850" y="90" width="400" height="320" as="geometry" /></mxCell>
        <mxCell id="build" value="build_from_paths()
per image: sha256, phash,
width, height, source, generator" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1"><mxGeometry x="880" y="135" width="340" height="80" as="geometry" /></mxCell>
        <mxCell id="clean" value="clean()
drop unreadable and blocklisted rows" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1"><mxGeometry x="880" y="230" width="340" height="55" as="geometry" /></mxCell>
        <mxCell id="validate" value="validate()
fails if one sha256 appears
in more than one split" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1"><mxGeometry x="880" y="300" width="340" height="75" as="geometry" /></mxCell>
        <mxCell id="blocklist" value="Blocklist
sha256 + 64-bit DCT phash
catches re-encoded near-duplicates
that sha256 alone misses" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="490" y="430" width="300" height="100" as="geometry" /></mxCell>
        <mxCell id="g_split" value="Splits" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fffbf0;strokeColor=#d6b656;dashed=1;verticalAlign=top;align=left;fontSize=13;fontStyle=1;fontColor=#7f6000;spacingLeft=10;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="1300" y="90" width="360" height="460" as="geometry" /></mxCell>
        <mxCell id="s_train" value="train
detector training" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1330" y="135" width="300" height="55" as="geometry" /></mxCell>
        <mxCell id="s_val" value="val
meta-dataset source (nb 03)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1330" y="205" width="300" height="55" as="geometry" /></mxCell>
        <mxCell id="s_test" value="test_unseen
held-out generator families" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1330" y="275" width="300" height="55" as="geometry" /></mxCell>
        <mxCell id="s_held" value="held
reserve" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1330" y="345" width="300" height="55" as="geometry" /></mxCell>
        <mxCell id="s_eval" value="eval_only
never trainable — benchmark set" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1330" y="415" width="300" height="55" as="geometry" /></mxCell>
        <mxCell id="hw1" value="HARDWARE — this stage is network- and CPU-bound, no GPU required.
Disk: ~2.9 GB for the eval-only set (COCO 0.07 GB + DALL·E 3 2.84 GB); a stratified WildFake training pull is budgeted at 15 GB by default." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="30" y="580" width="1620" height="45" as="geometry" /></mxCell>
        <mxCell id="note1" value="Leakage control is enforced, not documented: validate() raises when a sha256 straddles splits, and the phash blocklist catches WildFake shipping COCO train2017 and val2017 in one archive.
UNSEEN_GENERATORS (GigaGAN, GALIP, MAGE, SDwithAdaptor_lycris, Midjourney_Advanced) are held out wholesale so no generator family appears in both train and test." style="text;html=1;fontSize=10;align=left;verticalAlign=top;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="30" y="645" width="1620" height="60" as="geometry" /></mxCell>
        <mxCell id="e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#666666;fontSize=10;" edge="1" parent="1" source="wildfake" target="remotezip"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#666666;fontSize=10;" edge="1" parent="1" source="sidset" target="remotezip"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#666666;fontSize=10;" edge="1" parent="1" source="coco" target="remotezip"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#666666;fontSize=10;" edge="1" parent="1" source="remotezip" target="build"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e5" value="hashes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#666666;fontSize=10;" edge="1" parent="1" source="quarantine" target="blocklist"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#666666;fontSize=10;" edge="1" parent="1" source="blocklist" target="clean"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#666666;fontSize=10;" edge="1" parent="1" source="build" target="clean"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#666666;fontSize=10;" edge="1" parent="1" source="clean" target="validate"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#666666;fontSize=10;" edge="1" parent="1" source="validate" target="s_train"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#666666;fontSize=10;" edge="1" parent="1" source="validate" target="s_val"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#666666;fontSize=10;" edge="1" parent="1" source="validate" target="s_test"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e12" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#666666;fontSize=10;" edge="1" parent="1" source="validate" target="s_held"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e13" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#666666;fontSize=10;" edge="1" parent="1" source="quarantine" target="s_eval"><mxGeometry relative="1" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram name="2. Branch Training" id="page-train">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="980" background="#ffffff" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="Branch Training — Notebooks 01 and 02" style="text;html=1;fontSize=20;fontStyle=1;align=left;verticalAlign=middle;fontColor=#1a1a2e;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="1400" height="30" as="geometry" /></mxCell>
        <mxCell id="subtitle" value="two detectors trained on the train split; Community Forensics is used off the shelf and never trained here" style="text;html=1;fontSize=12;align=left;verticalAlign=middle;fontColor=#555555;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="40" y="42" width="1500" height="20" as="geometry" /></mxCell>
        <mxCell id="g_dino" value="Notebook 01 — DINOv3-L Expert  (Modeling/dinov3/)  [PyTorch · timm]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eef8f0;strokeColor=#82b366;dashed=1;verticalAlign=top;align=left;fontSize=13;fontStyle=1;fontColor=#2f6b3d;spacingLeft=10;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="30" y="90" width="780" height="600" as="geometry" /></mxCell>
        <mxCell id="d_data" value="train split → datasets.py
native crop, clean + degraded view pair" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="60" y="140" width="340" height="65" as="geometry" /></mxCell>
        <mxCell id="d_bb" value="DINOv3-L backbone   [timm]
vit_large_patch16_dinov3.lvd1689m
frozen · attention pooling" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="60" y="235" width="340" height="80" as="geometry" /></mxCell>
        <mxCell id="d_fc" value="FeatureCorrection  (residual FFN)
maps degraded features toward clean
zero-initialised output layer" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1"><mxGeometry x="60" y="345" width="340" height="80" as="geometry" /></mxCell>
        <mxCell id="d_head" value="Classifier head
head_hidden = 512, dropout 0.0
→ one logit" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1"><mxGeometry x="60" y="455" width="340" height="75" as="geometry" /></mxCell>
        <mxCell id="d_loss" value="Robust loss
BCE + clean/degraded consistency
AdamW · AMP · warmup + cosine" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1"><mxGeometry x="440" y="235" width="340" height="80" as="geometry" /></mxCell>
        <mxCell id="d_sel" value="Evaluation/training_validation.py
clean + degradation grid
select on robust AUC" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1"><mxGeometry x="440" y="345" width="340" height="80" as="geometry" /></mxCell>
        <mxCell id="d_ckpt" value="weights/dinov3/notebook_dinov3/
best_robust.pt   (1.2 GB)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="440" y="455" width="340" height="75" as="geometry" /></mxCell>
        <mxCell id="d_note" value="Inference uses 8 random 224px crops per image and averages the sigmoids.
crop_mode = random_crop — images below 224px are TILED, not resized." style="text;html=1;fontSize=10;align=left;verticalAlign=top;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="60" y="560" width="720" height="55" as="geometry" /></mxCell>
        <mxCell id="g_stack" value="Notebook 02 — DINOv3-B Stacking Head  (Modeling/stacking/)  [PyTorch · timm · transformers]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eef4fc;strokeColor=#6c8ebf;dashed=1;verticalAlign=top;align=left;fontSize=13;fontStyle=1;fontColor=#2f4f7f;spacingLeft=10;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="860" y="90" width="800" height="600" as="geometry" /></mxCell>
        <mxCell id="s_data" value="train split
3 crops per image at 224px" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="890" y="140" width="340" height="65" as="geometry" /></mxCell>
        <mxCell id="s_bb" value="FrozenBackbone   [timm]
vit_base_patch16_dinov3.lvd1689m
dim = 768 · never updated" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="890" y="235" width="340" height="80" as="geometry" /></mxCell>
        <mxCell id="s_cf" value="Community Forensics   [transformers]
P(fake) → logit
extra_dim = 1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1290" y="235" width="340" height="80" as="geometry" /></mxCell>
        <mxCell id="s_concat" value="Concat + normalise
768 embedding + 1 expert logit" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1"><mxGeometry x="890" y="345" width="740" height="60" as="geometry" /></mxCell>
        <mxCell id="s_head" value="StackingHead MLP
FeatureCorrection · head_hidden 256
dropout 0.1 → one logit" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1"><mxGeometry x="890" y="435" width="340" height="80" as="geometry" /></mxCell>
        <mxCell id="s_ckpt" value="weights/stacking/notebook_vitb/
best_robust.pt   (9.8 MB)
best_robust_auc = 0.9945" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1290" y="435" width="340" height="80" as="geometry" /></mxCell>
        <mxCell id="s_note" value="Only the head is trained — hence 9.8 MB against the expert's 1.2 GB. The frozen backbone is
re-downloaded from timm at load time and is never stored in the checkpoint." style="text;html=1;fontSize=10;align=left;verticalAlign=top;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="890" y="545" width="740" height="55" as="geometry" /></mxCell>
        <mxCell id="hw2" value="HARDWARE — training the DINOv3-L branch is intended for a CUDA GPU (AMP mixed precision; the 300M-parameter backbone plus activations is the memory driver).
The stacking branch is TWO phases with different needs. Phase 1, Workflows/cache_features.py: the frozen ViT-B and the Community Forensics expert run over every training image × 3 crops × 3 variants (clean, jpeg=50, blur=1.0) — nine backbone forwards per image, and firmly GPU work. Phase 2, head.fit(): reads those cached float16 features, batch 1024, 30 epochs, and only the 768→256 MLP takes gradients — that phase alone is CPU-feasible." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="30" y="720" width="1620" height="50" as="geometry" /></mxCell>
        <mxCell id="note2" value="Both checkpoints are selected on robustness (a degradation grid: JPEG, blur, downscale, noise), not on clean accuracy. A detector that only works on pristine images is of no use on images that have been through a social feed." style="text;html=1;fontSize=10;align=left;verticalAlign=top;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="30" y="790" width="1620" height="40" as="geometry" /></mxCell>
        <mxCell id="f1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#666666;fontSize=10;" edge="1" parent="1" source="d_data" target="d_bb"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="f2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#666666;fontSize=10;" edge="1" parent="1" source="d_bb" target="d_fc"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="f3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#666666;fontSize=10;" edge="1" parent="1" source="d_fc" target="d_head"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="f4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#666666;fontSize=10;" edge="1" parent="1" source="d_head" target="d_loss"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="f5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#666666;fontSize=10;" edge="1" parent="1" source="d_loss" target="d_sel"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="f6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#666666;fontSize=10;" edge="1" parent="1" source="d_sel" target="d_ckpt"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="f7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#666666;fontSize=10;" edge="1" parent="1" source="s_data" target="s_bb"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="f8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#666666;fontSize=10;" edge="1" parent="1" source="s_bb" target="s_concat"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="f9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#666666;fontSize=10;" edge="1" parent="1" source="s_cf" target="s_concat"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="f10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#666666;fontSize=10;" edge="1" parent="1" source="s_concat" target="s_head"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="f11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#666666;fontSize=10;" edge="1" parent="1" source="s_head" target="s_ckpt"><mxGeometry relative="1" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram name="3. Fusion Selection" id="page-fusion">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="900" background="#ffffff" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="Fusion Selection — Notebooks 03 and 04" style="text;html=1;fontSize=20;fontStyle=1;align=left;verticalAlign=middle;fontColor=#1a1a2e;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="1400" height="30" as="geometry" /></mxCell>
        <mxCell id="subtitle" value="2,000-image meta-dataset → ten candidate fusions → 5-fold CV on development only → one refit model" style="text;html=1;fontSize=12;align=left;verticalAlign=middle;fontColor=#555555;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="40" y="42" width="1500" height="20" as="geometry" /></mxCell>
        <mxCell id="g_meta" value="Notebook 03 — Meta-dataset" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fffbf0;strokeColor=#d6b656;dashed=1;verticalAlign=top;align=left;fontSize=13;fontStyle=1;fontColor=#7f6000;spacingLeft=10;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="30" y="90" width="520" height="440" as="geometry" /></mxCell>
        <mxCell id="m_val" value="val manifest
sampled across source/generator groups
so no large group dominates" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="60" y="140" width="460" height="75" as="geometry" /></mxCell>
        <mxCell id="m_bal" value="1,000 real (0)  +  1,000 fake (1)
balanced, reproducible, seed 1337" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="60" y="240" width="460" height="60" as="geometry" /></mxCell>
        <mxCell id="m_score" value="Score all three branches
models built and released one at a time
to bound peak memory" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1"><mxGeometry x="60" y="325" width="460" height="75" as="geometry" /></mxCell>
        <mxCell id="m_csv" value="Four columns:
CF Pr · DINOv3-L Pr · DINOv3-B Pr  +  ground truth" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="60" y="425" width="460" height="60" as="geometry" /></mxCell>
        <mxCell id="g_sel" value="Notebook 04 — Model selection   [scikit-learn · xgboost]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eef8f0;strokeColor=#82b366;dashed=1;verticalAlign=top;align=left;fontSize=13;fontStyle=1;fontColor=#2f6b3d;spacingLeft=10;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="600" y="90" width="1060" height="440" as="geometry" /></mxCell>
        <mxCell id="f_split" value="One 70 / 30 split
1,383 development  ·  617 final test
groups kept together by _diversity_group" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1"><mxGeometry x="630" y="140" width="460" height="80" as="geometry" /></mxCell>
        <mxCell id="f_cands" value="Ten candidate fusions
logistic · SVM · trees · splines ·
weighted means · calibrated variants" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1130" y="140" width="500" height="80" as="geometry" /></mxCell>
        <mxCell id="f_cv" value="Stratified 5-fold CV — development only
scaling, calibration, hyperparameters and
thresholds all fitted inside each fold" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1"><mxGeometry x="630" y="250" width="1000" height="80" as="geometry" /></mxCell>
        <mxCell id="f_rule" value="Selection rule
maximise mean CV balanced accuracy,
tie-break on lower mean CV log loss" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1"><mxGeometry x="630" y="360" width="460" height="80" as="geometry" /></mxCell>
        <mxCell id="f_win" value="Selected: SVM (linear)
StandardScaler → SVC(C=0.1, probability=True)
threshold = 0.70" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#b6d7a8;strokeColor=#38761d;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1130" y="360" width="500" height="80" as="geometry" /></mxCell>
        <mxCell id="f_art" value="weights/fusion/selected_final_fusion.joblib   [joblib]
model · model_name · threshold · feature_order" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="600" y="570" width="620" height="70" as="geometry" /></mxCell>
        <mxCell id="f_test" value="Final test evaluated ONCE
617 rows, never consulted during selection" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1280" y="570" width="380" height="70" as="geometry" /></mxCell>
        <mxCell id="hw3" value="HARDWARE — notebook 03 needs the GPU (it runs all three detectors over 2,000 images). Notebook 04 is pure scikit-learn on a 2,000×3 table: CPU only, seconds to run." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="30" y="690" width="1620" height="35" as="geometry" /></mxCell>
        <mxCell id="note3" value="feature_order in the artifact is the contract: Workflows/classify.py reads it to decide which detectors to run and in what order. Re-running notebook 04 with a different feature set changes the CLI's behaviour without any code edit — and an unknown feature name raises rather than silently mis-ordering the fusion inputs." style="text;html=1;fontSize=10;align=left;verticalAlign=top;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="30" y="745" width="1620" height="55" as="geometry" /></mxCell>
        <mxCell id="h1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#666666;fontSize=10;" edge="1" parent="1" source="m_val" target="m_bal"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="h2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#666666;fontSize=10;" edge="1" parent="1" source="m_bal" target="m_score"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="h3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#666666;fontSize=10;" edge="1" parent="1" source="m_score" target="m_csv"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="h4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#666666;fontSize=10;" edge="1" parent="1" source="m_csv" target="f_split"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="h5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#666666;fontSize=10;" edge="1" parent="1" source="f_split" target="f_cv"><mxGeometry relative="1" as="geometry" /></mxCell>
