224px crops" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1"><mxGeometry x="285" y="550" width="180" height="80" as="geometry" /></mxCell>
        <mxCell id="c3_bb" value="DINOv3-B frozen
dim 768" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="495" y="550" width="180" height="80" as="geometry" /></mxCell>
        <mxCell id="c3_extra" value="Community Forensics
logit  (extra_dim = 1)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="495" y="645" width="180" height="75" as="geometry" /></mxCell>
        <mxCell id="c3_cat" value="Concat +
normalise" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1"><mxGeometry x="705" y="550" width="150" height="80" as="geometry" /></mxCell>
        <mxCell id="c3_head" value="StackingHead MLP
hidden 256 → logit" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1"><mxGeometry x="885" y="550" width="180" height="80" as="geometry" /></mxCell>
        <mxCell id="c3_tta" value="sigmoid ×3,
then mean" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1095" y="550" width="130" height="80" as="geometry" /></mxCell>
