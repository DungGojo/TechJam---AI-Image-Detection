        <mxCell id="c2_box" value="Branch 2 — DINOv3-L Detector  (custom-trained expert, 1.2 GB)   [PyTorch · timm]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eef8f0;strokeColor=#82b366;dashed=1;verticalAlign=top;align=left;fontSize=13;fontStyle=1;fontColor=#2f6b3d;spacingLeft=10;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="250" y="250" width="1000" height="220" as="geometry" /></mxCell>
        <mxCell id="c2_crop" value="Sample 8 random
224px crops
(tiles if smaller)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1"><mxGeometry x="285" y="300" width="200" height="90" as="geometry" /></mxCell>
        <mxCell id="c2_bb" value="DINOv3-L backbone
frozen · attention pooling" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="515" y="300" width="230" height="90" as="geometry" /></mxCell>
        <mxCell id="c2_fc" value="FeatureCorrection
+ head (512)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1"><mxGeometry x="775" y="300" width="190" height="90" as="geometry" /></mxCell>
